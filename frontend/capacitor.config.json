{
  "appId": "com.tonyoga.app",
  "appName": "TonYoga",
  "webDir": "build",
  "backgroundColor": "#FAFAF7",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#FAFAF7",
      "showSpinner": false
    }
  },
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "allowMixedContent": false
  }
}
