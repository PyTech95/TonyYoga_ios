{
  "appId": "com.tonyoga.app",
  "appName": "TonYoga",
  "webDir": "build",
  "backgroundColor": "#FAFAF7",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#FAFAF7",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "LIGHT"
    }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#FAFAF7",
    "scrollEnabled": true
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FAFAF7"
  }
}
