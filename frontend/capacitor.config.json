{
  "appId": "com.tonysanchezyoga.app",
  "appName": "Tony Sanchez Yoga",
  "webDir": "build",
  "backgroundColor": "#FAFAF7",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
