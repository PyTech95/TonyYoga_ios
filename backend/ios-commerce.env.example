# ADD reviewed values to the EXISTING backend/.env; do not replace that file.
IOS_COMMERCE_ENABLED=false
IOS_COMMERCE_CATALOG_FILE=/etc/tonyoga/ios-commerce.json
IOS_APPLE_ROOT_CERTS_DIR=/etc/tonyoga/apple-roots
# Numeric App Store Connect Apple ID for TonYoga, NOT bundle ID or Team ID.
IOS_APPLE_APP_ID=REPLACE_WITH_NUMERIC_APPLE_ID
# TestFlight uses Sandbox. Also allow the real tester accounts in the catalog.
IOS_IAP_ALLOW_SANDBOX=true
# Enable after database backup and reviewing the 30-day deletion cleanup/retention policy.
ACCOUNT_DELETION_PURGE_ENABLED=false
# Use the real PayPal REST-app webhook ID (different live/sandbox IDs); never a placeholder.
PAYPAL_WEBHOOK_ID=REPLACE_WITH_REAL_PAYPAL_WEBHOOK_ID
# Preserve the matching CREDENTIALS_MASTER_KEY. Do not generate a new encryption key.
# Preserve current PayPal/Printful/SMTP credentials, DB_NAME, MONGO_URL and JWT_SECRET.
